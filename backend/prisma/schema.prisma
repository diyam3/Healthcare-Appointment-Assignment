generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  patient
  doctor
  admin
}

enum AppointmentStatus {
  held
  confirmed
  completed
  cancelled_by_patient
  cancelled_by_leave
}

enum ReminderType {
  appointment
  medication
}

enum NotificationStatus {
  pending
  sent
  failed
}

model User {
  id                 String            @id @default(uuid())
  name               String
  email              String            @unique
  passwordHash       String            @map("password_hash")
  role               Role              @default(patient)
  googleRefreshToken String?           @map("google_refresh_token")
  createdAt          DateTime          @default(now()) @map("created_at")

  doctor        Doctor?
  slotHolds     SlotHold[]
  appointments  Appointment[]     @relation("PatientAppointments")
  reminders     Reminder[]
  notifications NotificationLog[]

  @@map("users")
}

model Doctor {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  name            String
  specialization  String
  slotDurationMin Int      @default(30) @map("slot_duration_min")
  workingHours    Json     @map("working_hours")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaves       DoctorLeave[]
  slotHolds    SlotHold[]
  appointments Appointment[]

  @@map("doctors")
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String   @map("doctor_id")
  leaveDate DateTime @map("leave_date")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, leaveDate])
  @@map("doctor_leaves")
}

model SlotHold {
  id            String   @id @default(uuid())
  doctorId      String   @map("doctor_id")
  patientId     String   @map("patient_id")
  slotStartTime DateTime @map("slot_start_time")
  expiresAt     DateTime @map("expires_at")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")

  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, slotStartTime])
  @@map("slot_holds")
}

model Appointment {
  id              String            @id @default(uuid())
  doctorId        String            @map("doctor_id")
  patientId       String            @map("patient_id")
  slotStartTime   DateTime          @map("slot_start_time")
  status          AppointmentStatus @default(held)
  symptomsText    String?           @map("symptoms_text")
  preVisitSummary Json?             @map("pre_visit_summary")
  urgencyLevel    String?           @map("urgency_level")
  clinicalNotes   String?           @map("clinical_notes")
  prescription    Json?
  postVisitSummary Json?            @map("post_visit_summary")
  googleEventId   String?           @map("google_event_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  doctor        Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient       User           @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  reminders     Reminder[]

  @@unique([doctorId, slotStartTime])
  @@map("appointments")
}

model Prescription {
  id            String   @id @default(uuid())
  appointmentId String   @map("appointment_id")
  drugName      String   @map("drug_name")
  dosage        String
  frequency     String
  durationDays  Int      @map("duration_days")
  createdAt     DateTime @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("prescriptions")
}

model Reminder {
  id            String       @id @default(uuid())
  appointmentId String       @map("appointment_id")
  userId        String       @map("user_id")
  type          ReminderType
  scheduledAt   DateTime     @map("scheduled_at")
  sent          Boolean      @default(false)
  retryCount    Int          @default(0) @map("retry_count")
  createdAt     DateTime     @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model NotificationLog {
  id           String             @id @default(uuid())
  userId       String             @map("user_id")
  channel      String
  type         String
  status       NotificationStatus @default(pending)
  errorMessage String?            @map("error_message")
  sentAt       DateTime?          @map("sent_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications_log")
}
