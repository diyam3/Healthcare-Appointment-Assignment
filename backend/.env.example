# Application
PORT=3001
APP_BASE_URL=http://localhost:3001
APP_FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/healthcare_db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Email (Nodemailer SMTP)
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback

# LLM Provider (anthropic | openai | gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key

# Slot hold duration (minutes)
SLOT_HOLD_MINUTES=8

# Reminder (hours before appointment)
REMINDER_HOURS_BEFORE=24

# Encryption key for Google refresh tokens (32-byte hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Admin seed credentials (used by prisma/seed.js)
ADMIN_EMAIL=admin@healthcare.local
ADMIN_PASSWORD=Admin@1234
ADMIN_NAME=System Admin
